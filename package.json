{
  "name": "handscroll",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "yarn workspaces foreach -A --exclude handscroll run typecheck && tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:dep": "node tools/check-deps.mjs",
    "test:engine": "vitest run packages/core packages/tiles packages/assets packages/interaction",
    "test:plugins": "vitest run packages/plugins packages/core",
    "test:content": "vitest run packages/scene tools/scene-validator",
    "playground": "yarn workspace @handscroll/playground dev",
    "viewer": "yarn workspace @handscroll/viewer dev",
    "content:new": "node tools/content-new.mjs",
    "content:tiles": "yarn workspace @handscroll/tile-builder start",
    "content:scaffold-scene": "yarn workspace @handscroll/scene-scaffold start",
    "content:validate": "yarn workspace @handscroll/scene-validator start",
    "content:validate:all": "yarn workspace @handscroll/scene-validator start --all",
    "content:preview": "yarn workspace @handscroll/viewer dev",
    "content:generate-demo": "yarn workspace @handscroll/tile-builder generate-demo"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
